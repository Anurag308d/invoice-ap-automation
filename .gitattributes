# Force LF line endings for every text file so the SHA-256 checksums recorded in the
# source manifest are byte-identical on Windows, macOS and Linux checkouts.
* text=auto eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.sql   text eol=lf
*.edi   text eol=lf
*.html  text eol=lf
*.png   binary
*.pdf   binary
